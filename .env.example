# =============================================================
# Orquestador - Variables de Entorno (Plantilla)
# =============================================================
# Copia este archivo a .env y configura los valores
# =============================================================

# Zona horaria
TZ=America/Mexico_City

# =============================================================
# Redis - Cola y Historial
# =============================================================
REDIS_PASSWORD=orquestador123

# =============================================================
# Servicios de IA (stack agente_ia via nginx load balancer)
# =============================================================
# URLs de los servicios de IA (via nginx para escalado)
STT_URL=http://agente_ia:8001
TTS_URL=http://agente_ia:8002
LLM_URL=http://agente_ia:11434

# Modelos de Ollama
LLM_CHAT_MODEL=qwen2.5:7b
LLM_IMG_MODEL=llava:7b
LLM_DOCS_MODEL=dolphin-llama3:8b

# =============================================================
# Evolution API (Messaging Stack en 172.16.1.58)
# =============================================================
# URL del servidor Evolution API (IP del servidor mensajeria)
EVOLUTION_URL=http://172.16.1.58:8080

# API Key de Evolution (obtener de .env del mensajeria stack)
# Variable AUTHENTICATION_API_KEY en mensajeria/.env
EVOLUTION_API_KEY=CAMBIAR_POR_TU_API_KEY

# =============================================================
# Webhook (Evolution debe enviar eventos aqui)
# =============================================================
# Configurar en Evolution: http://172.16.1.57:8000/webhook/evolution
# WEBHOOK_URL=http://172.16.1.57:8000/webhook/evolution

# =============================================================
# Autoscaler - Escalado automatico de workers
# =============================================================
# Nombre de la cola en Redis a monitorear
QUEUE_KEY=mensajes:pendientes

# Intervalo de chequeo en segundos
AUTOSCALE_CHECK_INTERVAL=30

# Umbrales de escalado
# - Si cola > UP_THRESHOLD: agregar worker
# - Si cola < DOWN_THRESHOLD: reducir worker
AUTOSCALE_UP_THRESHOLD=20
AUTOSCALE_DOWN_THRESHOLD=10

# Limites de workers
AUTOSCALE_MIN_WORKERS=1
AUTOSCALE_MAX_WORKERS=5

# Cooldown entre escalados (segundos) - evita cambios rapidos
AUTOSCALE_COOLDOWN=60
